{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "css-fart-tools",
  "main": "worker/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    // Static assets win over the Worker by default; `/` must reach the Worker
    // so it can negotiate `Accept: text/css`.
    "run_worker_first": ["/"]
  },
  "routes": [{ "pattern": "css.fart.tools", "custom_domain": true }]
}
